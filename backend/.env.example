# Esquema numerado unificado en todos los repos. El colector canonico
# (config/api_keys.py) lee GEMINI_API_KEY1..20, acepta lista en una linea
# (GEMINI_API_KEYS=k1,k2,k3) y deduplica por valor.
#
# Gemini limita por proyecto de Google Cloud y Groq por organizacion, asi que
# sumar keys multiplica cuota solo si vienen de proyectos/cuentas distintas.
GEMINI_API_KEY1=your_gemini_api_key_here
GEMINI_API_KEY2=
GROQ_API_KEY1=your_groq_api_key_here
GROQ_API_KEY2=
NVIDIA_API_KEY=your_nvidia_api_key_here
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

AI_TEXT_PROVIDER_ORDER=gemini,openrouter,groq
AI_TEXT_PROVIDER_SELECTION=round_robin
AI_TEXT_FALLBACK_MODE=quota_only
AI_TEXT_TIMEOUT_SECONDS=45

AI_TEXT_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# gemini-2.5-flash devuelve 404 "no longer available to new users" (verificado 2026-08-06)
AI_TEXT_GEMINI_MODEL=gemini-flash-latest

AI_TEXT_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_TEXT_OPENROUTER_MODEL=gpt-4o-mini

AI_TEXT_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_TEXT_GROQ_MODEL=llama-3.3-70b-versatile

# Base de datos
# Todos los entornos usan PostgreSQL via DATABASE_URL.
DATABASE_URL=postgresql://postgres:your_password_here@127.0.0.1:5432/gestorcoc

# Password temporal para seeds de desarrollo. Si no se define y DEBUG=True,
# seed_system_users usara Temp123456! como fallback. Con DEBUG=False es
# obligatorio definir SYSTEM_USERS_DEFAULT_PASSWORD o SYSTEM_USER_PASSWORD_<USUARIO>.
# SYSTEM_USERS_DEFAULT_PASSWORD=Temp123456!
